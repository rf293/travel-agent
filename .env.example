# SerpAPI — Google Flights JSON (primary)
SERPAPI_API_KEY=

# Duffel — flight offers API (test tokens start with duffel_test_)
DUFFEL_API_KEY=

# LetsFG — multi-source cloud search (PFS Bearer preferred)
# Run: letsfg auth   (opens letsfg.co/connect; nothing charged for search)
# Or set the token from ~/.letsfg/config.json
LETSFG_BEARER_TOKEN=
# Optional Developer API key (prepaid credits — prefer Bearer for agents)
# LETSFG_API_KEY=
# Wait for late split-ticket merge after status=completed (default 1)
# LETSFG_WAIT_FOR_SPLIT=1

# Amadeus for Developers — GDS fallback
# https://developers.amadeus.com/
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# test | production (default test)
AMADEUS_ENV=test
