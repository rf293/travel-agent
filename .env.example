# SerpAPI — Google Flights JSON (primary)
SERPAPI_API_KEY=

# Duffel — flight offers API (test tokens start with duffel_test_)
DUFFEL_API_KEY=

# LetsFG — multi-source cloud search (PFS preferred)
# Run once: letsfg auth  (opens letsfg.co/connect; nothing charged for search)
# Tokens live in ~/.letsfg/config.json and auto-refresh (~1h access, ~30d refresh).
# Do NOT paste the short-lived access token here — that skips refresh and expires hourly.
# LETSFG_BEARER_TOKEN=
# Optional Developer API key (prepaid credits — prefer PFS for agents)
# LETSFG_API_KEY=
# Wait for late split-ticket merge after status=completed (default 1)
# LETSFG_WAIT_FOR_SPLIT=1

# Amadeus for Developers — GDS fallback
# https://developers.amadeus.com/
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# test | production (default test)
AMADEUS_ENV=test
